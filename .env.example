# Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Deploy via CLI (link, db push, functions deploy)
# REF: Project Settings -> General -> Reference ID
# PASSWORD: Project Settings -> Database -> Database password
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# URL pública do app (obrigatório para webhook WhatsApp em produção; em local use ngrok)
# Ex.: produção: https://seu-dominio.com
# Ex.: local + ngrok: https://abc123.ngrok-free.app (rode `npm run tunnel` e cole a URL que o ngrok mostrar)
NEXT_PUBLIC_APP_URL=

# Evolution API (opcional, usado para provisionamento automático de novos agentes)
# Quando preenchido, o onboarding do novo agente já cria instância + tenta configurar webhook.
EVOLUTION_AUTO_BASE_URL=
EVOLUTION_AUTO_API_KEY=

# Assistente pessoal + orçamento (feature/assistente-pessoal-orcamento)
# true = ativa resolveActorByPhone, mode internal/external, intents de agenda/orçamento.
# false = comportamento igual ao MVP atual (sem modo internal).
FEATURE_ASSISTENTE_ORCAMENTO=false

# Webhook / outbox WhatsApp
# Segredo usado para autorizar o dreno interno do outbox.
WHATSAPP_OUTBOX_SECRET=
# false = responde mais rapido ao webhook; true = simula \"digitando\" via Evolution.
EVOLUTION_ENABLE_TYPING_SIMULATION=false
