# =============================================================================
# AMBIENTE QA — Projeto Supabase separado para testes antes de produção
# =============================================================================
# Uso:
#   1. Copie: cp .env.qa.example .env.qa
#   2. Preencha as chaves abaixo (Dashboard do projeto QA → Project Settings → API)
#   3. Para rodar o app contra QA localmente: use .env.qa como fonte ou copie para .env.local
#   4. No VPS: use este arquivo como base do .env da instância de QA (não misture com prod)
#
# Projeto QA: jfxlbffnzliapmcxfata
# =============================================================================

# Supabase (projeto QA)
NEXT_PUBLIC_SUPABASE_URL=https://jfxlbffnzliapmcxfata.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Deploy via CLI (projeto QA)
SUPABASE_PROJECT_REF=jfxlbffnzliapmcxfata
SUPABASE_DB_PASSWORD=

# URL pública do app de QA (obrigatório para webhooks; ex.: https://qa.seudominio.com ou ngrok)
NEXT_PUBLIC_APP_URL=

# Evolution API (opcional; pode usar mesma ou instância separada para QA)
EVOLUTION_AUTO_BASE_URL=
EVOLUTION_AUTO_API_KEY=

# Feature flag — em QA pode deixar true para testar assistente/orçamento
FEATURE_ASSISTENTE_ORCAMENTO=false
